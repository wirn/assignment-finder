# Copy locally to .env. Never commit real credentials.
# Use a long random DB password without connection-string delimiters (;).
DB_PASSWORD=
# At least 32 random characters. Only trusted clients receive this key.
ADMIN_API_KEY=
APP_PORT=8091
# Set these to the owner of private bind-mounted files (id -u / id -g on Linux).
APP_USER_ID=1654
APP_GROUP_ID=1654
# This initial host imports saved JSON only. AI, SMTP and scheduling are disabled.
